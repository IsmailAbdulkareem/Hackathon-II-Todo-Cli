# Database Configuration
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# For Neon Serverless: postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/todo_db

# CORS Configuration
# Comma-separated list of allowed origins for frontend integration
# Development: http://localhost:3000
# Production: https://yourdomain.com
CORS_ORIGINS=http://localhost:3000

# JWT Authentication Secret (shared with frontend)
# IMPORTANT: Generate this ONCE using a cryptographically secure method:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# This secret must match the frontend's BETTER_AUTH_SECRET
# The backend uses this ONLY for JWT verification (python-jose)
# The backend does NOT connect to Better Auth's database
BETTER_AUTH_SECRET=your-jwt-secret-here

# Groq Configuration (Phase 3: AI Chatbot)
# Groq API key for LLM inference
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key-here

# Groq model to use for chat agent
# Recommended: openai/gpt-oss-120b, llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_MODEL=openai/gpt-oss-120b

# MCP Server Port (Model Context Protocol)
# Port for MCP server to expose task management tools
MCP_SERVER_PORT=8001
